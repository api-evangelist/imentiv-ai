            "description": {
              "content": "Retrieve the conversation history for a specific media item's AI Insights session.\n\n## Response\n\nReturns all messages (user questions and AI responses) in chronological order.\n\n**Empty History:** If no conversation exists yet, returns an empty `messages` array with a conversation_id. The conversation will be created automatically when you send your first message via POST.\n\n## Supported Media Types\n\nvideo, audio, image, text",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                ":media_type",
                ":media_id",
                "ai-insights"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
